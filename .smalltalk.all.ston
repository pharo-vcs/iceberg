SmalltalkCISpec {
  #name: 'Iceberg',
  #preLoading: 'scripts/preLoading.st',
  #postLoading: 'scripts/postLoading.st',
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'Iceberg',
      #platforms : [ #pharo ],
      #ignoreImage : true,
      #onConflict : #useIncoming,
      #onUpgrade : #useIncoming,
      #onWarningLog : true,
      #load : [ 'development' ]
     }
  ],
  #preTesting: 'scripts/preTesting.st',
  #testing : {
  	#include : { 
  		#packages : [ '.*' ] 
  	},
  	#exclude : {
  		#packages : [ 
  			'UnifiedFFI.*',
  			'ThreadedFFI.*',
  			'Monticello.*',
  			'Metacello.*',
  			'System-Settings-Tests.*',
  			'ReleaseTests.*',
  			'Files-Tests.*',
  			'Zinc-Tests.*',
  			'Iceberg.*' ],
  		#classes : [
  			#OutOfMemoryTest,
  			#PlatformResolverTest,
  			#ProcessSpecificTest,
  			#UDPSocketTest
  		] 
  	}
  }  
}
