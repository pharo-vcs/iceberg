SmalltalkCISpec {
  #name: 'Iceberg',
  #preLoading: 'scripts/preLoading.st',
  #postLoading: 'scripts/postLoading.st',
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'Iceberg',
      #ignoreImage : true,
      #onConflict : #useIncoming,
      #onUpgrade : #useIncoming,
      #onWarningLog : true
     }
  ],
  #preTesting: 'scripts/preTesting.st',
  #testing : {
  	#include : { 
  		#packages : [ '.*' ] 
  	},
  	#exclude : {
  		#packages : [ 
  			'GT-Tests.*', 
  			'Glamour-Tests.*',
  			'UnifiedFFI.*',
  			'ThreadedFFI.*',
  			'Monticello.*',
  			'Metacello.*',
  			'System-Settings-Tests.*',
  			'RPackage.*',
  			'ReleaseTests.*' ],
  		#classes : [
  			#OutOfMemoryTest,
  			#TraitFileOutTest,
  			#PlatformResolverTest,
  			#ProcessSpecificTest
  		] 
  	}
  }  
}
