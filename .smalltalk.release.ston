SmalltalkCISpec {
  #name: 'Iceberg',
  #preLoading: 'scripts/preLoading.st',
  #postLoading: 'scripts/postLoading.st',
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'Iceberg',
      #ignoreImage : true,
      #onConflict : #useIncoming,
      #onUpgrade : #useIncoming,
      #onWarningLog : true
     }
  ],
  #preTesting: 'scripts/preTesting.st',
  #testing : {
  	#packages : [ 
  		'System-Settings-Tests.*',
  		'ReleaseTests.*' ] 
  }  
}
